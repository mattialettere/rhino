<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>it</string>
  <key>CFBundleExecutable</key><string>kurva3d</string>
  <key>CFBundleIconFile</key><string>kurva3d.icns</string>
  <key>CFBundleIdentifier</key><string>app.kurva3d.Kurva3D</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>Kurva3D</string>
  <key>CFBundleDisplayName</key><string>Kurva3D</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@PROJECT_VERSION@</string>
  <key>CFBundleVersion</key><string>@PROJECT_VERSION@</string>
  <key>NSHumanReadableCopyright</key><string>Copyright © 2026 @KURVA3D_PUBLISHER@</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>LSMinimumSystemVersion</key><string>@KURVA3D_MACOS_MIN@</string>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>Modello 3D</string>
      <key>CFBundleTypeExtensions</key><array><string>3dm</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
    <dict>
      <!-- formati di scambio: Kurva3D compare in "Apri con" e accetta i file trascinati sull'icona -->
      <key>CFBundleTypeName</key><string>Disegno CAD</string>
      <key>CFBundleTypeExtensions</key><array>
        <string>dxf</string><string>stp</string><string>step</string><string>igs</string><string>iges</string>
        <string>stl</string><string>obj</string><string>gltf</string><string>glb</string><string>3mf</string><string>ply</string><string>fbx</string><string>dae</string><string>3ds</string>
      </array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
  </array>
</dict>
</plist>
